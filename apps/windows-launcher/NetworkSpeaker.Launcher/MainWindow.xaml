<Window x:Class="NetworkSpeaker.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Network Speaker"
        Width="900"
        Height="780"
        MinWidth="820"
        MinHeight="700"
        Loaded="Window_OnLoaded"
        StateChanged="Window_OnStateChanged">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Padding="16"
            Margin="0,0,0,16"
            BorderBrush="#D0D7DE"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel>
        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Text="Network Speaker" />
        <TextBlock Margin="0,8,0,0"
                   Foreground="#4B5563"
                   Text="Configure hostd.exe without typing command-line arguments. Start and stop Windows audio forwarding from a single window." />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1"
          Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Padding="16"
              Margin="0,0,16,0"
              BorderBrush="#D0D7DE"
              BorderThickness="1"
              CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Row="0"
                     Grid.Column="0"
                     VerticalAlignment="Center"
                     Text="Target IP" />
          <TextBox Grid.Row="0"
                   Grid.Column="1"
                   Margin="8,0,0,12"
                   Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Grid.Row="1"
                     Grid.Column="0"
                     VerticalAlignment="Center"
                     Text="UDP Port" />
          <TextBox Grid.Row="1"
                   Grid.Column="1"
                   Margin="8,0,0,12"
                   Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Grid.Row="2"
                     Grid.Column="0"
                     VerticalAlignment="Center"
                     Text="Seconds (optional)" />
          <TextBox Grid.Row="2"
                   Grid.Column="1"
                   Margin="8,0,0,0"
                   Text="{Binding Seconds, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Padding="16"
              BorderBrush="#D0D7DE"
              BorderThickness="1"
              CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Row="0"
                     Grid.Column="0"
                     VerticalAlignment="Center"
                     Text="Source" />
          <ComboBox Grid.Row="0"
                    Grid.Column="1"
                    Margin="8,0,0,12"
                    ItemsSource="{Binding AvailableSources}"
                    SelectedItem="{Binding SelectedSource}" />

          <TextBlock Grid.Row="1"
                     Grid.Column="0"
                     VerticalAlignment="Center"
                     Text="WASAPI Role" />
          <ComboBox Grid.Row="1"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    IsEnabled="{Binding IsWasapiRoleEnabled}"
                    ItemsSource="{Binding AvailableWasapiRoles}"
                    SelectedItem="{Binding SelectedWasapiRole}" />
        </Grid>
      </Border>
    </Grid>

    <!-- Audio Device Selection -->
    <Border Grid.Row="2"
            Padding="16"
            Margin="0,0,0,16"
            BorderBrush="#D0D7DE"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel>
        <TextBlock FontWeight="SemiBold"
                   Text="Audio Device" />

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox Grid.Column="0"
                    IsEnabled="{Binding IsDeviceComboBoxEnabled}"
                    ItemsSource="{Binding AvailableDevices}"
                    SelectedItem="{Binding SelectedDevice}"
                    DisplayMemberPath="Name" />
          <Button Grid.Column="1"
                  Margin="8,0,0,0"
                  Padding="12,4"
                  Content="Refresh"
                  Click="RefreshDevicesButton_OnClick"
                  IsEnabled="{Binding IsDeviceComboBoxEnabled}" />
        </Grid>

        <!-- Virtual audio cable detected -->
        <StackPanel Margin="0,10,0,0"
                    Orientation="Horizontal"
                    Visibility="{Binding HasVirtualAudioDevice, Converter={StaticResource BoolToVis}}">
          <Ellipse Width="10"
                   Height="10"
                   Fill="#22C55E"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0" />
          <TextBlock Foreground="#15803D"
                     VerticalAlignment="Center"
                     Text="Virtual audio cable detected. App-specific audio routing is available." />
        </StackPanel>

        <!-- No virtual audio cable -->
        <StackPanel Margin="0,10,0,0"
                    Orientation="Horizontal">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasVirtualAudioDevice}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Ellipse Width="10"
                   Height="10"
                   Fill="#EAB308"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0" />
          <TextBlock VerticalAlignment="Center"
                     Foreground="#854D0E">
            <Run Text="No virtual audio cable detected. Install " />
            <Hyperlink Click="VbCableLink_OnClick">VB-CABLE (free)</Hyperlink>
            <Run Text=" for app-specific audio routing. After installing, click Refresh." />
          </TextBlock>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="3"
            Padding="16"
            Margin="0,0,0,16"
            BorderBrush="#D0D7DE"
            BorderThickness="1"
            CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="2"
                   FontWeight="SemiBold"
                   Text="Runtime" />

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Margin="0,12,12,4"
                   VerticalAlignment="Center"
                   Text="hostd.exe Path" />
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Margin="0,8,0,8"
                 IsReadOnly="True"
                 Text="{Binding HostdPath, Mode=OneWay}" />

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Margin="0,8,12,4"
                   VerticalAlignment="Center"
                   Text="Command Preview" />
        <TextBox Grid.Row="2"
                 Grid.Column="1"
                 Margin="0,4,0,8"
                 IsReadOnly="True"
                 Text="{Binding CommandPreview, Mode=OneWay}" />

        <StackPanel Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Margin="0,16,0,0"
                    Orientation="Horizontal">
          <Button Width="120"
                  Margin="0,0,12,0"
                  Click="StartButton_OnClick"
                  Content="Start"
                  IsEnabled="{Binding CanStart}" />
          <Button Width="120"
                  Click="StopButton_OnClick"
                  Content="Stop"
                  IsEnabled="{Binding CanStop}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="4"
            Padding="16"
            Margin="0,0,0,16"
            BorderBrush="#D0D7DE"
            BorderThickness="1"
            CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontWeight="SemiBold"
                   Text="Logs" />
        <TextBox Grid.Row="1"
                 Margin="0,12,0,0"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 IsReadOnly="True"
                 Text="{Binding LogsText, Mode=OneWay}"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />
      </Grid>
    </Border>

    <Border Grid.Row="5"
            Padding="12"
            Background="#F6F8FA"
            BorderBrush="#D0D7DE"
            BorderThickness="1"
            CornerRadius="8">
      <TextBlock Text="{Binding StatusText}"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
